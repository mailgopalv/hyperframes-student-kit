# Personal inputs, transcripts, edit decisions, and renders stay local.
.env
.env.*
!.env.example
*.env
*.pem
*.key
node_modules/
raw-media/
video-projects/
renders/
**/renders/
**/assets/
tmp/
archives/
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.zip
*.log
__pycache__/
*.pyc
.DS_Store
Thumbs.db
.vscode/
.claude/settings.local.json
.codex/auth.json
.codex/sessions/
.codex/history.jsonl

# ExploreAI brand kit (copied into each project by new-video) and the retired
# AIS brand archive. Root assets/ only; project assets stay ignored.
!/assets/
/assets/*
!/assets/brand-token.css
!/assets/exploreai-logo.png
!/assets/exploreai-background.png
!/assets/exploreai-brand-guidelines.png
!/assets/fonts/
!/assets/old/

# Deliberately public synthetic timing data, without media.
!examples/short-form/assets/
!examples/short-form/assets/*.json

# Three finished videos explicitly supplied for the public showcase.
!examples/showcase/curiosity-reel-2.mp4
!examples/showcase/curiosity-reel-1.mp4
!examples/showcase/ais-live-ad.mp4
