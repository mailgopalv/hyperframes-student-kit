<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1920, height=1080">
    <title>What is MCP? — Support Agent Walkthrough</title>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&family=JetBrains+Mono:wght@400;500;700&display=block" rel="stylesheet">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body {
        width: 1920px; height: 1080px; overflow: hidden;
        background: #07121c; font-family: "Montserrat", sans-serif; color: #ffffff;
      }
      #talkinghead-frame {
        position: absolute; inset: 0; width: 1920px; height: 1080px; overflow: hidden; background: #000;
      }
      #talkinghead-video {
        display: block; width: 100%; height: 100%; object-fit: cover;
      }
      .whip {
        position: absolute; top: 50%; left: 0; width: 46%; height: 10px;
        background: linear-gradient(90deg, transparent, #ffffff, transparent);
        filter: blur(8px); transform: translateY(-50%); opacity: 0; z-index: 100;
      }
    </style>
  </head>
  <body>
    <div data-hf-id="hf-kufj" id="root" data-composition-id="ai-mcp-walkthrough" data-start="0" data-width="1920" data-height="1080">
      <!-- Talking-head cold open, plain footage per creative direction (full-screen, no motion graphics) -->
      <div data-hf-id="hf-fs9n" id="talkinghead-frame">
        <video data-hf-id="hf-j14v" id="talkinghead-video" data-start="0" data-duration="39.0" data-track-index="0" src="assets/talkinghead-intro.mp4" muted playsinline></video>
      </div>

      <!-- Continuous narration track under the whole POC -->
      <audio data-hf-id="hf-wxyr" id="narration" data-start="0" data-duration="484.9" data-track-index="1" src="assets/narration-poc.m4a" data-volume="1"></audio>

      <!-- Ambient grid/vignette/grain behind every motion-graphics beat -->
      <div data-hf-id="hf-tbtj" id="ambient-bg" data-composition-id="ambient-bg" data-composition-src="compositions/ambient-bg.html" data-start="39.0" data-duration="445.9" data-track-index="2"></div>

      <!-- Content beats, sequential on one track -->
      <div data-hf-id="hf-q79s" id="c-roadmap" data-composition-id="roadmap" data-composition-src="compositions/01-roadmap.html" data-start="39.0" data-duration="40.0" data-track-index="3"></div>
      <div data-hf-id="hf-hafr" id="c-ecommerce" data-composition-id="ecommerce" data-composition-src="compositions/02-ecommerce-example.html" data-start="79.0" data-duration="34.0" data-track-index="3"></div>
      <div data-hf-id="hf-hv00" id="c-agent-evolution" data-composition-id="agent-evolution" data-composition-src="compositions/03-support-agent-evolution.html" data-start="113.0" data-duration="248.2" data-track-index="3"></div>
      <div data-hf-id="hf-mttq" id="c-drawbacks" data-composition-id="drawbacks" data-composition-src="compositions/04-drawbacks.html" data-start="361.2" data-duration="115.2" data-track-index="3"></div>
      <div data-hf-id="hf-6wm2" id="c-mcp-transition" data-composition-id="mcp-transition" data-composition-src="compositions/05-mcp-transition.html" data-start="476.4" data-duration="8.5" data-track-index="3"></div>

      <!-- Whip-streak bridging every cut between beats (Law #5 — never a hard cut) -->
      <div data-hf-id="hf-dspt" id="whip-0" class="whip clip" data-start="38.8" data-duration="0.4" data-track-index="5"></div>
      <div data-hf-id="hf-del8" id="whip-1" class="whip clip" data-start="78.8" data-duration="0.4" data-track-index="5"></div>
      <div data-hf-id="hf-v1vg" id="whip-2" class="whip clip" data-start="112.8" data-duration="0.4" data-track-index="5"></div>
      <div data-hf-id="hf-xvqx" id="whip-3" class="whip clip" data-start="361.0" data-duration="0.4" data-track-index="5"></div>
      <div data-hf-id="hf-cwcd" id="whip-4" class="whip clip" data-start="476.2" data-duration="0.4" data-track-index="5"></div>

      <!-- Captions, always on top -->
      <div data-hf-id="hf-n2bh" id="captions" data-composition-id="captions" data-composition-src="compositions/captions.html" data-start="0" data-duration="484.9" data-track-index="6"></div>
    </div>

    <script>
      (function () {
        const tl = gsap.timeline({ paused: true });

        ["whip-0", "whip-1", "whip-2", "whip-3", "whip-4"].forEach(function (id) {
          const el = document.getElementById(id);
          const start = parseFloat(el.getAttribute("data-start"));
          gsap.set(el, { xPercent: -100, scaleX: 0.5 });
          tl.fromTo(
            "#" + id,
            { opacity: 0, xPercent: -100, scaleX: 0.5 },
            { opacity: 1, xPercent: 250, scaleX: 1.5, duration: 0.4, ease: "power3.in" },
            start,
          );
          tl.set("#" + id, { opacity: 0 }, start + 0.4);
        });

        tl.set({}, {}, 484.9);
        window.__timelines = window.__timelines || {};
        window.__timelines["ai-mcp-walkthrough"] = tl;
      })();
    </script>
  </body>
</html>
